{
  "name": "@viamedici-spc/configurator-framer-bundle",
  "version": "0.0.0",
  "description": "Component library to build configurator apps with Framer based on Viamedici SPC. All dependencies are bundled together.",
  "keywords": [
    "configuration",
    "configurator",
    "constraint",
    "csp",
    "framer",
    "hca",
    "problem",
    "product",
    "satisfaction",
    "solver",
    "spc",
    "viamedici"
  ],
  "license": "MIT",
  "author": "Viamedici Software GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamedici-spc/configurator-framer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run --cwd ../configurator-framer build && tsdown",
    "dev": "tsdown --watch",
    "preview": "bun preview.ts",
    "typecheck": "bun check",
    "verify": "bun run --parallel typecheck verify:package",
    "verify:package": "bun run build && publint --strict",
    "prepack": "cp ../../README.md README.md",
    "postpack": "rm README.md"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.5",
    "@viamedici-spc/configurator-framer": "workspace:*",
    "@viamedici-spc/configurator-react": "5.0.0-modern-toolchain-20261126115224",
    "@viamedici-spc/configurator-ts": "5.0.0-modern-toolchain-20261126114204",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2"
  },
  "inlinedDependencies": {
    "@floating-ui/core": "1.8.0",
    "@floating-ui/dom": "1.8.0",
    "@floating-ui/react": "0.26.28",
    "@floating-ui/react-dom": "2.1.9",
    "@floating-ui/utils": "0.2.12",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/react-fontawesome": "0.2.6",
    "@morphic-ts/adt": "3.0.0",
    "@morphic-ts/batteries": "3.0.0",
    "@morphic-ts/common": "3.0.0",
    "@morphic-ts/eq-interpreters": "3.0.0",
    "@morphic-ts/fastcheck-interpreters": "3.0.0",
    "@morphic-ts/io-ts-interpreters": "3.0.0",
    "@morphic-ts/show-interpreters": "3.0.0",
    "@morphic-ts/summoners": "3.0.0",
    "@viamedici-spc/configurator-react": "5.0.0-modern-toolchain-20261126115224",
    "@viamedici-spc/configurator-ts": "5.0.0-modern-toolchain-20261126114204",
    "@viamedici-spc/fp-ts-extensions": "2.0.0-modern-toolchain-20261126094931",
    "camelcase": "8.0.0",
    "clsx": "2.1.1",
