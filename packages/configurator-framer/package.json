{
  "name": "@viamedici-spc/configurator-framer",
  "version": "0.0.0",
  "description": "Component library to build configurator apps with Framer based on Viamedici SPC.",
  "keywords": [
    "configuration",
    "configurator",
    "constraint",
    "csp",
    "framer",
    "hca",
    "problem",
    "product",
    "satisfaction",
    "solver",
    "spc",
    "viamedici"
  ],
  "license": "MIT",
  "author": "Viamedici Software GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamedici-spc/configurator-framer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format:check": "bun fmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "typecheck": "bun check && bun check -p tests",
    "verify": "bun run --parallel typecheck lint format:check test verify:package",
    "verify:package": "bun run build && publint --strict && attw --pack . --profile esm-only --format table-flipped",
    "prepack": "cp ../../README.md README.md",
    "postpack": "rm README.md"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.9",
    "@floating-ui/react-dom": "^2.1.2",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@viamedici-spc/configurator-react": "5.0.0-modern-toolchain-20261126115224",
    "@viamedici-spc/configurator-ts": "5.0.0-modern-toolchain-20261126114204",
    "@viamedici-spc/fp-ts-extensions": "2.0.0-modern-toolchain-20261126094931",
    "camelcase": "^8.0.0",
    "clsx": "^2.1.0",
    "dyna-guid": "^2.1.2",
    "fp-ts": "^2.16.11",
    "hex-to-css-filter": "^5.4.0",
    "merge-props": "^6.0.0",
    "mustache": "^4.2.0",
    "react-error-boundary": "^4.0.11",
    "react-number-format": "^4.9.3",
    "rgb-hex": "^4.1.0",
    "styled-components": "^6.1.1",
    "ts-pattern": "^5.0.6",
    "url-join": "^5.0.0",
    "use-debounce": "^8.0.4",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/mustache": "^4.2.5",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "framer": "^2.4.1",
    "framer-motion": "^10.13.1",
    "jsdom": "^31",
    "oxlint": "^1.94.0",
    "publint": "^0.3.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2",
    "vitest": "^5"
  },
  "peerDependencies": {
    "framer": ">=2.4.1",
    "react": "^18.2 || ^19"
  },
  "inlinedDependencies": {
    "framer-motion": "10.18.0"
  }
}